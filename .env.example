# ==============================================================================
# PROJECT CLOIE - Environment Variables Template
# Copy this file to .env.local and fill in your Supabase credentials.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=""

# Supabase Anon/Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

NEXT_PUBLIC_SITE_URL=""

# Prisma Database Connections (Available from Supabase -> Project Settings -> Database)
# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL=""

# Direct connection to the database. Used for migrations (Prisma db push / migrate).
DIRECT_URL=""

# Required in production for protected Secretary edit confirmations.
CONFIRMATION_SECRET=""

# Local development only. This legacy flag does not enable dedicated demo authentication.
NEXT_PUBLIC_DEMO_MODE=""

# Authentication modes:
# - Primary Production uses Supabase Google OAuth and must not receive CLOIE_DEMO_* values.
# - Local development may use cloie_dev_auth / POST /api/auth/dev-login.
# - Dedicated demo deployment uses the server-only values below for signed demo sessions.
# Keep all CLOIE_DEMO_* values server-only; never use NEXT_PUBLIC_.
# Demo authentication must fail closed unless the deployment is explicitly marked as isolated demo.
CLOIE_DEMO_ENABLED=""
CLOIE_DEPLOYMENT_KIND=""
CLOIE_DEMO_SESSION_SECRET=""
CLOIE_DEMO_ALLOWED_USERS=""
# Bound the destructive demo reset command to this one isolated Supabase project.
# These refs also bind runtime demo authentication to the isolated project.
# Both refs are server-only deployment configuration, never browser configuration.
CLOIE_DEMO_SUPABASE_PROJECT_REF=""
CLOIE_PRIMARY_SUPABASE_PROJECT_REF=""

# Bootstrap Secretary email (one-time setup for first Secretary account)
BOOTSTRAP_SECRETARY_EMAIL=""

# Server-only HMAC secret for the short-lived pre-OAuth legal acknowledgement ticket.
# Use a long random value in every deployed environment; do not expose as NEXT_PUBLIC_.
CLOIE_LEGAL_TICKET_SECRET=""

# Supabase CLI cloud workflow
SUPABASE_PROJECT_REF=""
SUPABASE_ACCESS_TOKEN=""
SUPABASE_DB_PASSWORD=""

# Test-only: opt in to DB invariant test suites (`pnpm test:db`).
# Leave unset so `pnpm test` never writes to a hosted database.
# When set to "1", point DATABASE_URL at a disposable test database, not shared Supabase.
RUN_DATABASE_INTEGRATION_TESTS=""
