# ==============================================================================
# PROJECT CLOIE - Environment Variables Template
# Copy this file to .env and fill in your Supabase credentials.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=""

# Supabase Anon/Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

NEXT_PUBLIC_SITE_URL=""

# Prisma Database Connections (Available from Supabase -> Project Settings -> Database)
# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL=""

# Direct connection to the database. Used for migrations (Prisma db push / migrate).
DIRECT_URL=""

# Required in production for protected Secretary edit confirmations.
CONFIRMATION_SECRET=""

# Local development only. This legacy flag does not enable dedicated demo authentication.
NEXT_PUBLIC_DEMO_MODE=""

# Authentication modes:
# - Primary Production uses Supabase Google OAuth and must not receive CLOIE_DEMO_* values.
# - Local development may use cloie_dev_auth / POST /api/auth/dev-login.
# - Dedicated demo deployment uses the server-only values below for signed demo sessions.
# Keep all CLOIE_DEMO_* values server-only; never use NEXT_PUBLIC_.
# Demo authentication must fail closed unless the deployment is explicitly marked as isolated demo.
CLOIE_DEMO_ENABLED=""
CLOIE_DEPLOYMENT_KIND=""
CLOIE_DEMO_SESSION_SECRET=""
CLOIE_DEMO_ALLOWED_USERS=""
# Bound the destructive demo reset command to this one isolated Supabase project.
# These refs also bind runtime demo authentication to the isolated project.
# Both refs are server-only deployment configuration, never browser configuration.
CLOIE_DEMO_SUPABASE_PROJECT_REF=""
CLOIE_PRIMARY_SUPABASE_PROJECT_REF=""

# Isolated CI test authentication for production-mode browser journeys.
# Restricted to disposable CI environment (localhost/disposable host) and deterministic seeded catalog.
# Requires CLOIE_DEPLOYMENT_KIND=ci-test to fail closed on Primary Production.
# Server-only; never set on Primary Production or dedicated demo deployment.
CLOIE_CI_TEST_ENABLED=""
CLOIE_CI_TEST_SESSION_SECRET=""
CLOIE_CI_TEST_ALLOWED_USERS=""

# Server-only primary Production appearance release control. Leave unset/empty by default.
# Appearance is enabled only when deployment configuration sets this to exactly "true";
# unset, empty, "false", malformed, and all other values remain disabled.
# Follow docs/runbooks/appearance-production-activation.md; never expose through NEXT_PUBLIC_.
CLOIE_APPEARANCE_ENABLED=""

# Bootstrap Secretary email (one-time setup for first Secretary account)
BOOTSTRAP_SECRETARY_EMAIL=""

# Server-only HMAC secret for the short-lived pre-OAuth legal acknowledgement ticket.
# Use a long random value in every deployed environment; do not expose as NEXT_PUBLIC_.
CLOIE_LEGAL_TICKET_SECRET=""

# Supabase CLI cloud workflow
SUPABASE_PROJECT_REF=""
SUPABASE_ACCESS_TOKEN=""
SUPABASE_DB_PASSWORD=""

# Test-only: opt in to DB invariant test suites (`pnpm test:db`).
# Leave unset so `pnpm test` never writes to a hosted database.
# When set to "1", point DATABASE_URL at a disposable test database, not shared Supabase.
RUN_DATABASE_INTEGRATION_TESTS=""

# Server-only bounded AI Insights configuration (Program Head analytics).
# The feature is disabled unless CLOIE_AI_ENABLED is exactly "true" AND every
# required value below is present and valid; any malformed value disables the
# feature. AI Insights sends only bounded de-identified aggregate evidence to
# the configured OpenAI-compatible provider, never raw comments, and results
# are validated and never persisted. Production enablement is separately
# governed by docs/adr/0016-server-side-bounded-ai-interpretation-boundary.md.
CLOIE_AI_ENABLED=""
CLOIE_AI_API_KEY=""
CLOIE_AI_BASE_URL=""
CLOIE_AI_MODEL=""
# Corpus gates: interpretation is refused (provider is never called) until the
# selected scope has at least these counts of submitted responses and
# non-empty qualitative items.
CLOIE_AI_MIN_SUBMITTED_RESPONSES=""
CLOIE_AI_MIN_QUALITATIVE_ITEMS=""
# Optional bounds (defaults: 50 tokens, 16000 packet chars). Positive integers only.
CLOIE_AI_MAX_TOKENS=""
CLOIE_AI_MAX_PACKET_CHARS=""
