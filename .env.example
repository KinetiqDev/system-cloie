# ==============================================================================
# SYSTEM CLOIE - Application Environment Variables Template
# Copy this file to .env.local (local development) or to the deployment
# environment of the System CLOIE application. Supabase Cloud is not supported:
# every target is either the local Supabase CLI Docker stack or an
# independently deployed self-hosted Supabase Docker instance.
#
# SCOPE: application runtime values, plus the local Supabase Google credentials.
# This file is deliberately the application-only contract. Mail delivery is NOT
# configured here: Supabase Auth is the sole mail sender, so there is no SMTP
# host, username, password, or template URL in this file, and adding one would
# be a security defect. Mail delivery, the emailed-code lifetime, code length,
# resend cooldown, rate limits, password minimum, and redirect origins are
# configured on the Supabase instance itself - see
# supabase/docker-compose.auth-mail.yml and supabase/mail.env.example, applied
# by docs/runbooks/external-entry-mail.md.
#
# The only value below that participates in mail is NEXT_PUBLIC_SITE_URL, which
# makes verification and recovery redirects deterministic behind a proxy.
# ==============================================================================

# Minimum deployed application setup:
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_SITE_URL,
# DATABASE_URL, DIRECT_URL, CLOIE_DEPLOYMENT_KIND, CLOIE_BACKEND_ID,
# CONFIRMATION_SECRET and CLOIE_LEGAL_TICKET_SECRET.
# Generate each HMAC secret separately with: openssl rand -hex 32
# Keep demo and CI-test authentication disabled on primary production.
# No SMTP credential or production service-role key is required by Next.js.
# Existing CI uses disposable keys/mail capture; add no production SMTP secrets.

# --- Public client contract (browser-safe; the only NEXT_PUBLIC_ values) ---
# Public URL of the Supabase-compatible backend. Local CLI Docker:
#   http://127.0.0.1:54321
# Self-hosted: the instance's browser-reachable public HTTPS API origin.
# Do not use a private Docker hostname in a NEXT_PUBLIC_ URL.
NEXT_PUBLIC_SUPABASE_URL=""

# Browser-safe public (anon) key of the configured backend. Local CLI Docker
# prints this from `pnpm supabase:status`; self-hosted operators configure it
# with the instance's public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Public site URL of this System CLOIE deployment. Use http://localhost:3000
# for normal local development. Leave unset while using an ephemeral
# trycloudflare Quick Tunnel so browser redirects use its current origin.
NEXT_PUBLIC_SITE_URL=""

# --- Server database contract (Prisma) ---
# Pooled/runtime PostgreSQL connection. Local CLI Docker:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=""

# Direct PostgreSQL connection. Used for remote migration list, dry-run, push,
# and type generation (the repository commands pass it through --db-url).
# Local CLI Docker: same value as DATABASE_URL above.
DIRECT_URL=""

# --- Backend identity (server-only, opaque) ---
# CLOIE_BACKEND_ID identifies the currently running deployment. It is an
# operator-assigned opaque string, compared by strict equality only, and is
# NEVER derived from hostnames, URLs, or Docker names. Allowed characters:
# [A-Za-z0-9._-]; non-empty, no whitespace. Leave unset for local development
# and disposable CI. Never expose it through NEXT_PUBLIC_*, logs, or evidence.
CLOIE_BACKEND_ID=""

# Deployment kind: "development" | "production" | "dedicated-demo" | "ci-test".
CLOIE_DEPLOYMENT_KIND=""

# Opaque identity of the primary Production backend. Must differ from
# CLOIE_DEMO_BACKEND_ID. Server-only; never logged.
CLOIE_PRIMARY_BACKEND_ID=""

# Opaque identity of the dedicated demo deployment. Dedicated demo
# authentication and reset require CLOIE_BACKEND_ID to equal this value and
# differ from CLOIE_PRIMARY_BACKEND_ID. Server-only; never logged.
CLOIE_DEMO_BACKEND_ID=""

# Opaque identity of the dedicated demo database. This must match the private
# marker stored on that database before any destructive demo reset can run.
# Server-only; never logged.
CLOIE_DEMO_DATABASE_ID=""

# --- Google OAuth credentials (consumed by Supabase, never by the app) -------
# These are NOT application runtime values: no Next.js code reads them. They
# are consumed by supabase/config.toml on the local CLI Docker stack through
# environment substitution (env(GOOGLE_CLIENT_ID) / env(GOOGLE_CLIENT_SECRET)),
# so they are listed here for the local `.env.local` only. Never commit them.
# For a self-hosted target, configure Google in the base Supabase Compose file
# and register the authorized redirect URI
# <API_EXTERNAL_URL>/callback on the Google Cloud OAuth client; see
# docs/runbooks/external-entry-mail.md.
# Local CLI Docker authorized redirect URI:
#   http://127.0.0.1:54321/auth/v1/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Dedicated demo authentication (server-only) ---
# Enable only on the dedicated demo deployment, together with
# CLOIE_DEPLOYMENT_KIND=dedicated-demo and the demo backend identity.
# Demo authentication fails closed when identity is missing or inconsistent.
CLOIE_DEMO_ENABLED=""
CLOIE_DEMO_SESSION_SECRET=""
CLOIE_DEMO_ALLOWED_USERS=""

# --- Isolated CI test authentication (server-only) ---
# Restricted to disposable CI environments (localhost/disposable host) and the
# deterministic seeded catalog. Requires CLOIE_DEPLOYMENT_KIND=ci-test.
CLOIE_CI_TEST_ENABLED=""
CLOIE_CI_TEST_SESSION_SECRET=""
CLOIE_CI_TEST_ALLOWED_USERS=""

# --- Application secrets (server-only) ---
# Required in production for protected Secretary edit confirmations.
CONFIRMATION_SECRET=""

# Bootstrap Secretary email (one-time setup for first Secretary account).
BOOTSTRAP_SECRETARY_EMAIL=""

# Server-only HMAC secret for the short-lived pre-OAuth legal acknowledgement
# ticket. Use a long random value in every deployed environment; never expose
# as NEXT_PUBLIC_.
CLOIE_LEGAL_TICKET_SECRET=""

# Server-only primary Production appearance release control. Leave unset/empty
# by default; enable only when deployment configuration sets this to exactly
# "true". Follow docs/runbooks/appearance-production-activation.md.
CLOIE_APPEARANCE_ENABLED=""

# Local development only. Legacy flag; does not enable dedicated demo
# authentication.
NEXT_PUBLIC_DEMO_MODE=""

# --- Test-only: DB invariant suites ---
# Opt in to `pnpm test:db` (RUN_DATABASE_INTEGRATION_TESTS=1). Leave unset so
# `pnpm test` never writes to a shared database. When set, point DATABASE_URL
# at a positively identified disposable test database.
RUN_DATABASE_INTEGRATION_TESTS=""

# --- Server-only bounded AI Insights configuration (Program Head analytics) ---
# The feature is disabled unless CLOIE_AI_ENABLED is exactly "true" AND every
# required value below is present and valid; any malformed value disables the
# feature. AI Insights sends only bounded de-identified aggregate evidence to
# the configured OpenAI-compatible provider, never raw comments, and results
# are validated and never persisted. Production enablement is separately
# governed by docs/adr/0016-server-side-bounded-ai-interpretation-boundary.md.
CLOIE_AI_ENABLED=""
CLOIE_AI_API_KEY=""
CLOIE_AI_BASE_URL=""
CLOIE_AI_MODEL=""
# Corpus gates: interpretation is refused (provider is never called) until the
# selected scope has at least these counts of submitted responses and
# non-empty qualitative items.
CLOIE_AI_MIN_SUBMITTED_RESPONSES=""
CLOIE_AI_MIN_QUALITATIVE_ITEMS=""
# Optional bounds (defaults: 50 tokens, 16000 packet chars). Positive integers only.
CLOIE_AI_MAX_TOKENS=""
CLOIE_AI_MAX_PACKET_CHARS=""
