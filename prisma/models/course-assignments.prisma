enum YearLevel {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FOURTH_YEAR

  @@map("year_level")
}

enum CourseScope {
  GENERAL_EDUCATION
  PROGRAM_SPECIFIC
}

enum StudentSection {
  MORNING
  AFTERNOON
  EVENING

  @@map("student_section")
}

enum EnrollmentSource {
  ONBOARDING
  ROLLOVER
  SECRETARY

  @@map("enrollment_source")
}

model StudentEnrollment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_user_id  String           @db.Uuid
  term_instance_id String           @db.Uuid
  program_id       String           @db.Uuid
  major_id         String?          @db.Uuid
  year_level       YearLevel
  section          StudentSection?
  source           EnrollmentSource
  is_active        Boolean          @default(true)
  created_by       String?          @db.Uuid
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  student User                 @relation(fields: [student_user_id], references: [id], onDelete: Cascade)
  term    AcademicTermInstance @relation(fields: [term_instance_id], references: [id], onDelete: Cascade)
  program Program              @relation(fields: [program_id], references: [id], onDelete: Restrict)
  major   Major?               @relation(fields: [major_id], references: [id], onDelete: SetNull)
  creator User?                @relation("EnrollmentCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@unique([student_user_id, term_instance_id])
  @@index([term_instance_id, program_id, year_level, section])
  @@index([is_active])
  @@map("student_enrollments")
}

model Course {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String            @unique
  title              String
  seed_source        String?
  program_id         String?           @db.Uuid
  major_id           String?           @db.Uuid
  course_scope       CourseScope       @default(PROGRAM_SPECIFIC)
  default_year_level YearLevel?
  default_semester   AcademicSemester?
  default_term       AcademicTerm?
  is_active          Boolean           @default(true)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  program                    Program?             @relation(fields: [program_id], references: [id], onDelete: Restrict)
  major                      Major?               @relation(fields: [major_id], references: [id], onDelete: SetNull)
  cilos                      CILO[]
  bound_instrument_templates InstrumentTemplate[] @relation("BoundInstrumentTemplateCourse")
  course_assignments         CourseAssignment[]
  curriculum_courses         CurriculumCourse[]

  @@index([default_semester, default_term])
  @@map("courses")
}

model CourseAssignment {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  term_instance_id     String         @db.Uuid
  faculty_id           String         @db.Uuid
  course_id            String         @db.Uuid
  curriculum_course_id String?        @db.Uuid
  program_id           String         @db.Uuid
  year_level           YearLevel
  section              StudentSection
  assigned_by          String?        @db.Uuid
  is_active            Boolean        @default(true)
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  term_instance            AcademicTermInstance         @relation(fields: [term_instance_id], references: [id], onDelete: Cascade)
  faculty                  User                         @relation("faculty", fields: [faculty_id], references: [id], onDelete: Restrict)
  course                   Course                       @relation(fields: [course_id], references: [id], onDelete: Restrict)
  curriculumCourse         CurriculumCourse?            @relation(fields: [curriculum_course_id], references: [id], onDelete: SetNull)
  program                  Program                      @relation(fields: [program_id], references: [id], onDelete: Restrict)
  assigner                 User?                        @relation("AssignmentAssigner", fields: [assigned_by], references: [id], onDelete: SetNull)
  course_bound_evaluations CourseBoundEvaluation[]
  memberships              CourseAssignmentMembership[]

  // Unique constraint: one assignment per course/program/year/section per term (one faculty per class)
  // NULLS NOT DISTINCT enforced in SQL migration; mirrored here as index
  // Required as the target of the membership composite foreign key.
  @@unique([id, course_id, term_instance_id, program_id], map: "course_assignments_membership_scope_key")
  @@index([term_instance_id, course_id, program_id, year_level, section])
  @@index([term_instance_id, faculty_id])
  @@index([term_instance_id, course_id])
  @@index([curriculum_course_id])
  @@index([is_active])
  @@map("course_assignments")
}

model CourseAssignmentMembership {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_assignment_id String    @db.Uuid
  student_user_id      String    @db.Uuid
  course_id            String    @db.Uuid
  term_instance_id     String    @db.Uuid
  program_id           String    @db.Uuid
  is_active            Boolean   @default(true)
  created_by           String    @db.Uuid
  updated_by           String    @db.Uuid
  removed_by           String?   @db.Uuid
  removed_at           DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  course_assignment     CourseAssignment                 @relation(fields: [course_assignment_id, course_id, term_instance_id, program_id], references: [id, course_id, term_instance_id, program_id], onDelete: Cascade, onUpdate: Restrict)
  student               User                             @relation("CourseAssignmentMembershipStudent", fields: [student_user_id], references: [id], onDelete: Restrict)
  creator               User                             @relation("CourseAssignmentMembershipCreator", fields: [created_by], references: [id], onDelete: Restrict)
  updater               User                             @relation("CourseAssignmentMembershipUpdater", fields: [updated_by], references: [id], onDelete: Restrict)
  remover               User?                            @relation("CourseAssignmentMembershipRemover", fields: [removed_by], references: [id], onDelete: Restrict)
  evaluation_exclusions CourseBoundEvaluationExclusion[]

  @@unique([course_assignment_id, student_user_id], map: "course_assignment_memberships_assignment_student_key")
  @@unique([id, course_assignment_id], map: "course_assignment_memberships_id_assignment_key")
  @@index([course_assignment_id, is_active])
  @@index([student_user_id, term_instance_id])
  @@index([course_id, term_instance_id, program_id, is_active])
  @@map("course_assignment_memberships")
}
