enum AcademicSemester {
  FIRST  @map("1ST")
  SECOND @map("2ND")
  SUMMER

  @@map("academic_semester")
}

enum AcademicTerm {
  FIRST_TERM
  SECOND_TERM

  @@map("academic_term")
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("academic_period_status")
}

model SchoolYear {
  id                            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                          String            @unique
  start_date                    DateTime?         @db.Date
  end_date                      DateTime?         @db.Date
  is_archived                   Boolean           @default(false)
  archived_by                   String?           @db.Uuid
  archived_at                   DateTime?
  is_active                     Boolean           @default(false)
  active_semester               AcademicSemester?
  active_semester_activated_by  String?           @db.Uuid
  active_semester_activated_at  DateTime?
  created_at                    DateTime          @default(now())
  updated_at                    DateTime          @updatedAt

  term_instances                  AcademicTermInstance[]
  archived_by_user                User?                           @relation("ArchivedSchoolYears", fields: [archived_by], references: [id], onDelete: SetNull)
  active_semester_activated_by_user User?                         @relation("ActiveSemesterActivator", fields: [active_semester_activated_by], references: [id], onDelete: SetNull)
  curriculum_versions             CurriculumVersion[]

  // Prisma cannot express the partial unique index (at most one active School Year); the real constraint is managed via Supabase migration
  @@index([is_active])
  @@map("school_years")
}

model AcademicTermInstance {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_year_id String               @db.Uuid
  semester       AcademicSemester
  term           AcademicTerm?
  start_date     DateTime?            @db.Date
  end_date       DateTime?            @db.Date
  status         AcademicPeriodStatus @default(PLANNED)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt

  school_year              SchoolYear                       @relation(fields: [school_year_id], references: [id], onDelete: Cascade)
  student_enrollments      StudentEnrollment[]
  course_assignments       CourseAssignment[]
  course_bound_evaluations CourseBoundEvaluation[]
  central_deployments      CentralDeployment[]
  readiness_snapshot       AcademicPeriodReadinessSnapshot?

  // Prisma cannot express NULLS NOT DISTINCT; the actual unique constraint is managed via Supabase migration
  @@index([school_year_id, semester, term])
  @@index([status])
  @@map("academic_term_instances")
}

model AcademicPeriodReadinessSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period_id      String   @unique @db.Uuid
  contexts       Json
  program_totals Json
  schema_version Int      @default(1)
  created_at     DateTime @default(now())

  period AcademicTermInstance @relation(fields: [period_id], references: [id], onDelete: Restrict)

  @@map("academic_period_readiness_snapshots")
}
