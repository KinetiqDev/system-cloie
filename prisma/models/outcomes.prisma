enum CILOMappingManifestation {
  LEARNING
  PRACTICE
  OPPORTUNITY
}

model PLO {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String
  description String
  order       Int      @default(0)
  program_id  String   @db.Uuid
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  program       Program       @relation(fields: [program_id], references: [id], onDelete: Restrict)
  cilo_mappings CILOMapping[]

  @@unique([program_id, code])
  @@map("gos")
}

model CILO {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description String
  course_id   String   @db.Uuid
  created_by  String   @db.Uuid
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course                                 Course                                  @relation(fields: [course_id], references: [id], onDelete: Cascade)
  author                                 User                                    @relation(fields: [created_by], references: [id], onDelete: Restrict)
  cilo_mappings                          CILOMapping[]
  cilo_institutional_outcome_mappings    CILOInstitutionalOutcomeMapping[]
  question_bindings                      CourseBoundCiloQuestionBinding[]
  template_question_bindings             InstrumentTemplateCiloQuestionBinding[]

  @@map("cilos")
}
model InstitutionalOutcome {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  description String
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  cilo_mappings CILOInstitutionalOutcomeMapping[]

  @@map("institutional_outcomes")
}

model CILOInstitutionalOutcomeMapping {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cilo_id                  String                     @db.Uuid
  institutional_outcome_id String                     @db.Uuid
  manifestation            CILOMappingManifestation?
  created_by               String                     @db.Uuid
  updated_by               String                     @db.Uuid
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @updatedAt

  cilo                  CILO                  @relation(fields: [cilo_id], references: [id], onDelete: Cascade)
  institutional_outcome InstitutionalOutcome  @relation(fields: [institutional_outcome_id], references: [id], onDelete: Restrict)
  creator               User                  @relation("CILOInstitutionalOutcomeMappingCreator", fields: [created_by], references: [id], onDelete: Restrict)
  updater               User                  @relation("CILOInstitutionalOutcomeMappingUpdater", fields: [updated_by], references: [id], onDelete: Restrict)

  @@unique([cilo_id, institutional_outcome_id])
  @@index([cilo_id])
  @@index([institutional_outcome_id])
  @@map("cilo_institutional_outcome_mappings")
}

model CILOMapping {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cilo_id       String                     @db.Uuid
  plo_id        String                     @map("go_id") @db.Uuid
  manifestation CILOMappingManifestation?
  created_by    String?                    @db.Uuid
  updated_by    String?                    @db.Uuid
  created_at    DateTime                   @default(now())
  updated_at    DateTime?

  cilo     CILO   @relation(fields: [cilo_id], references: [id], onDelete: Cascade)
  plo      PLO    @relation(fields: [plo_id], references: [id], onDelete: Cascade)
  creator  User?  @relation("CILOMappingCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater  User?  @relation("CILOMappingUpdater", fields: [updated_by], references: [id], onDelete: SetNull)

  @@unique([cilo_id, plo_id])
  @@index([created_by])
  @@index([updated_by])
  @@map("cilo_mappings")
}
