enum CILOMappingManifestation {
  LEARNING
  PRACTICE
  OPPORTUNITY
}

enum POClassification {
  COMMON
  CORE
  PROFESSIONAL
  INSTITUTION_SPECIFIC
  UNCLASSIFIED
}

enum GEAlignmentMode {
  ILO
  COMMON_PO
}

model CommonProgramOutcome {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  description String
  order       Int      @default(0)
  source_ref  String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  program_pos PO[]
  ge_mappings CILOCommonPOMapping[]

  @@map("common_program_outcomes")
}

model OutcomeChange {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id   String   @db.Uuid
  input      Json
  before     Json
  after      Json
  created_at DateTime @default(now())
  actor      User     @relation(fields: [actor_id], references: [id], onDelete: Restrict)

  @@map("outcome_changes")
}

model CILOCommonPOMapping {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cilo_id           String @db.Uuid
  common_outcome_id String @db.Uuid
  manifestation     CILOMappingManifestation?
  created_by        String @db.Uuid
  updated_by        String @db.Uuid
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  cilo              CILO @relation(fields: [cilo_id], references: [id], onDelete: Cascade)
  common_outcome    CommonProgramOutcome @relation(fields: [common_outcome_id], references: [id], onDelete: Restrict)
  creator           User @relation("CILOCommonPOMappingCreator", fields: [created_by], references: [id], onDelete: Restrict)
  updater           User @relation("CILOCommonPOMappingUpdater", fields: [updated_by], references: [id], onDelete: Restrict)

  @@unique([cilo_id, common_outcome_id])
  @@index([common_outcome_id])
  @@map("cilo_common_po_mappings")
}

model PO {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String
  description String
  order       Int      @default(0)
  program_id  String   @db.Uuid
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  classification              POClassification @default(UNCLASSIFIED)
  common_outcome_id           String? @db.Uuid
  common_outcome              CommonProgramOutcome? @relation(fields: [common_outcome_id], references: [id], onDelete: Restrict)

  program                      Program                                @relation(fields: [program_id], references: [id], onDelete: Restrict)
  cilo_mappings                CILOMapping[]
  template_question_bindings   InstrumentTemplatePoQuestionBinding[]
  central_deployment_snapshots CentralDeploymentPoSnapshot[]
  course_bound_question_bindings CourseBoundPoQuestionBinding[]

  @@unique([program_id, code])
  @@unique([program_id, common_outcome_id])
  @@index([classification])
  @@index([common_outcome_id])
  @@map("gos")
}

model CILO {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description String
  course_id   String   @db.Uuid
  created_by  String   @db.Uuid
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course                              Course                                  @relation(fields: [course_id], references: [id], onDelete: Cascade)
  author                              User                                    @relation(fields: [created_by], references: [id], onDelete: Restrict)
  cilo_common_po_mappings              CILOCommonPOMapping[]
  cilo_mappings                       CILOMapping[]
  cilo_institutional_outcome_mappings CILOInstitutionalOutcomeMapping[]
  question_bindings                   CourseBoundCiloQuestionBinding[]
  template_question_bindings          InstrumentTemplateCiloQuestionBinding[]

  @@map("cilos")
}

model InstitutionalOutcome {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  description String
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  cilo_mappings CILOInstitutionalOutcomeMapping[]

  @@map("institutional_outcomes")
}

model CILOInstitutionalOutcomeMapping {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cilo_id                  String                    @db.Uuid
  institutional_outcome_id String                    @db.Uuid
  manifestation            CILOMappingManifestation?
  created_by               String                    @db.Uuid
  updated_by               String                    @db.Uuid
  created_at               DateTime                  @default(now())
  updated_at               DateTime                  @updatedAt

  cilo                  CILO                 @relation(fields: [cilo_id], references: [id], onDelete: Cascade)
  institutional_outcome InstitutionalOutcome @relation(fields: [institutional_outcome_id], references: [id], onDelete: Restrict)
  creator               User                 @relation("CILOInstitutionalOutcomeMappingCreator", fields: [created_by], references: [id], onDelete: Restrict)
  updater               User                 @relation("CILOInstitutionalOutcomeMappingUpdater", fields: [updated_by], references: [id], onDelete: Restrict)

  @@unique([cilo_id, institutional_outcome_id])
  @@index([cilo_id])
  @@index([institutional_outcome_id])
  @@map("cilo_institutional_outcome_mappings")
}

model CILOMapping {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cilo_id       String                    @db.Uuid
  po_id         String                    @map("po_id") @db.Uuid
  manifestation CILOMappingManifestation?
  created_by    String?                   @db.Uuid
  updated_by    String?                   @db.Uuid
  created_at    DateTime                  @default(now())
  updated_at    DateTime?

  cilo    CILO  @relation(fields: [cilo_id], references: [id], onDelete: Cascade)
  po      PO    @relation(fields: [po_id], references: [id], onDelete: Cascade)
  creator User? @relation("CILOMappingCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater User? @relation("CILOMappingUpdater", fields: [updated_by], references: [id], onDelete: SetNull)

  @@unique([cilo_id, po_id])
  @@index([created_by])
  @@index([updated_by])
  @@map("cilo_mappings")
}
