enum DeploymentType {
  COURSE_BOUND
  CENTRAL
}

enum ResponseStatus {
  IN_PROGRESS
  SUBMITTED
}

/// One export shape a Program Head report download can produce.
enum ReportExportKind {
  COURSE_WORKBOOK
  PROGRAM_OUTCOME_WORKBOOK
  RAW_QUANTITATIVE_CSV
}

model Response {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id   String         @unique @db.Uuid
  respondent_id   String         @db.Uuid
  deployment_type DeploymentType
  deployment_id   String         @db.Uuid
  status          ResponseStatus
  submitted_at    DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  assignment  EvaluationAssignment       @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  respondent  User                       @relation(fields: [respondent_id], references: [id], onDelete: Restrict)
  quant_items QuantitativeResponseItem[]
  qual_items  QualitativeResponseItem[]

  @@map("responses")
  @@index([deployment_id])
}

model QuantitativeResponseItem {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  response_id              String   @db.Uuid
  cilo_question_binding_id String?  @db.Uuid
  section_key              String
  item_key                 String
  rating_value             Int
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  response              Response                        @relation(fields: [response_id], references: [id], onDelete: Cascade)
  cilo_question_binding CourseBoundCiloQuestionBinding? @relation(fields: [cilo_question_binding_id], references: [id], onDelete: SetNull)

  @@map("quantitative_response_items")
  @@index([response_id])
}

/// Server-only audit record of one evidence export download.
///
/// Named-response report exports are confidential, so every download records
/// the exporting actor, the Program and filters it applied, and the size of
/// the submitted evidence it released. Only aggregate counts are stored here:
/// no respondent identity, response row, or rating value.
model ReportExportAudit {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id               String            @db.Uuid
  program_id             String            @db.Uuid
  export_kind            ReportExportKind
  identified             Boolean           @default(true)
  school_year_id         String?           @db.Uuid
  semester               AcademicSemester?
  term_instance_id       String?           @db.Uuid
  year_level             YearLevel?
  submitted_response_count Int            @default(0)
  rating_item_count      Int               @default(0)
  created_at             DateTime          @default(now())

  actor   User    @relation(fields: [actor_id], references: [id], onDelete: Restrict)
  program Program @relation(fields: [program_id], references: [id], onDelete: Restrict)

  @@map("report_export_audits")
  @@index([actor_id])
  @@index([program_id])
}

model QualitativeResponseItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  response_id  String   @db.Uuid
  section_key  String
  prompt_key   String
  text_content String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  response Response @relation(fields: [response_id], references: [id], onDelete: Cascade)

  @@map("qualitative_response_items")
  @@index([response_id])
}