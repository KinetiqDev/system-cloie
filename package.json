    "verify:database-suites": "tsx scripts/verify-database-suite-completeness.ts",
    "db:push": "prisma db push --schema prisma",
    "db:seed": "prisma generate --schema prisma && prisma db seed",
    "db:studio": "prisma studio --schema prisma",
