    "supabase:migration:diff": "tsx scripts/create-supabase-migration.ts diff",
    "supabase:migration:list": "tsx scripts/run-supabase-command.ts migration list --linked",
    "supabase:migration:repair-latest": "tsx scripts/repair-latest-supabase-migration.ts applied",
    "supabase:types": "tsx scripts/generate-supabase-types.ts",
    "supabase:push:dry-run": "tsx scripts/run-supabase-command.ts db push --linked --dry-run",
    "supabase:push": "tsx scripts/run-supabase-command.ts db push --linked"
