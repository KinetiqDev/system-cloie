{
  "name": "project-cloie",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "postinstall": "prisma generate --schema prisma",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:full": "vitest run",
    "test:focus": "vitest run",
    "fallow:audit": "pnpm exec fallow audit",
    "fallow:dead-code": "pnpm exec fallow dead-code",
    "fallow:dupes": "pnpm exec fallow dupes",
    "fallow:health": "pnpm exec fallow health",
    "fallow:flags": "pnpm exec fallow flags",
    "fallow:reports": "tsx scripts/run-fallow-reports.ts",
    "fallow:baseline": "tsx scripts/refresh-fallow-baselines.ts",
    "verify:production-auth-boundary": "tsx scripts/verify-production-auth-boundary.ts",
    "verify:dedicated-demo-auth-boundary": "tsx scripts/verify-dedicated-demo-auth-boundary.ts",
    "verify:demo-target-isolation": "tsx scripts/validate-demo-target-isolation.ts",
    "demo:reset": "tsx scripts/reset-demo-database.ts",
    "seed:baseline": "tsx scripts/seed-baseline-database.ts",
    "curriculum:generate-baseline": "tsx scripts/generate-baseline-curricula.ts",
    "academic:backfill-active-state": "tsx scripts/backfill-school-year-active-state.ts",
    "test:db": "tsx scripts/run-database-tests.ts",
