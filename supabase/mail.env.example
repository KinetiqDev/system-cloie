# ==============================================================================
# External Entry Mail — operator template
# ==============================================================================
# Copy this file to `mail.env` in the Supabase deployment repository
# (system-cloie-infra/supabase/), or paste the values into the Auth service's
# environment in the Coolify Supabase resource. This copy stays in git; the
# filled one never does.
#
#   cp mail.env.example mail.env
#
# NEVER put a filled copy in this repository, in a commit, in .env.example, or
# in the System CLOIE application deployment. Supabase Auth is the only mail
# sender, and its credentials belong to the infrastructure repository or a
# secrets manager. A filled `mail.env` here is git-ignored but still wrong.
#
# Every <<FILL: ...>> token below must be replaced before the Auth service is
# restarted. An unreplaced token is not a working host, so the instance fails
# closed rather than sending mail from a stranger's domain. Check for leftovers
# with the command at the end of this file.
#
# Cost rule: pick a free tier, never enter a payment method. See
# docs/runbooks/external-entry-mail.md.
# ==============================================================================

# --- 1. Pick one relay, and fill only that block ------------------------------
# Set every value in the chosen block. Leave the other blocks commented out;
# two live relays turn a delivery outage into a second bill.
# Free ceilings, verified 2026-09-29. Re-check before you rely on them.

# Option A — Brevo. Recommended default. 300 sends per day, 300 SMTP requests
# per hour, no credit card. Fail-closed at the ceiling.
# Console: https://app.brevo.com/settings/keys/smtp
SMTP_HOST="smtp.brevo.com"
SMTP_PORT="587"
SMTP_USER="<<FILL: brevo smtp login, usually the account e-mail or a generated key>>"
SMTP_PASS="<<FILL: brevo smtp key>>"
SMTP_ADMIN_EMAIL="<<FILL: the From address on a domain you control, e.g. no-reply@system-cloie.app>>"
SMTP_SENDER_NAME="System CLOIE"

# Option B — Resend. 3,000 per month, 100 per day. Requires a verified domain.
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend"
# SMTP_PASS="<<FILL: resend smtp key>>"
# SMTP_ADMIN_EMAIL="<<FILL: the From address on a domain you control>>"
# SMTP_SENDER_NAME="System CLOIE"

# Option C — Mailgun. 100 per day. Requires a verified domain.
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT="587"
# SMTP_USER="<<FILL: mailgun smtp username, the postmaster address for your domain>>"
# SMTP_PASS="<<FILL: mailgun smtp password>>"
# SMTP_ADMIN_EMAIL="<<FILL: the From address on a domain you control>>"
# SMTP_SENDER_NAME="System CLOIE"

# Option D — an ACD Google Workspace mailbox. No DNS work at all, but the mail
# arrives from a google.com address and is filtered hardest by university
# domains. Fallback only.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="<<FILL: the Workspace mailbox address>>"
# SMTP_PASS="<<FILL: a 16-character Google app password, not the account password>>"
# SMTP_ADMIN_EMAIL="<<FILL: the Workspace mailbox address>>"
# SMTP_SENDER_NAME="System CLOIE"

# Publish SPF and DKIM for the sending domain before going live. Without them a
# correct send still lands in spam. Sending needs SPF and DKIM only; no MX
# change is required.


# --- 2. Templates. Fill once, per target deployment ---------------------------
# GoTrue fetches these bodies over HTTP at send time and treats an unreachable
# URL as a send failure. Its built-in defaults render a link, not the
# {{ .Token }} the entry form needs, so a correct send can still be unusable.
# Source of truth for both bodies is this repository:
#   supabase/templates/confirm_signup.html
#   supabase/templates/recovery.html
# Keep {{ .Token }} in both.
MAILER_TEMPLATES_CONFIRMATION="<<FILL: https URL serving supabase/templates/confirm_signup.html>>"
MAILER_TEMPLATES_RECOVERY="<<FILL: https URL serving supabase/templates/recovery.html>>"
MAILER_TEMPLATES_SUBJECT_CONFIRMATION="Your System CLOIE verification code"
MAILER_TEMPLATES_SUBJECT_RECOVERY="Your System CLOIE password recovery code"


# --- 3. Auth switches. These are the recommended values; no filling needed ---
# Email signup on, autoconfirm off. Autoconfirm would let an unverified address
# reach domain linkage, and it also suppresses the verification mail entirely.
ENABLE_EMAIL_SIGNUP="true"
ENABLE_EMAIL_AUTOCONFIRM="false"

# Six-digit codes, matching the entry form's code field.
MAILER_OTP_LENGTH="6"
# Seconds. Keep at or below GOTRUE_SECURITY_MAX_AGE so a code cannot outlive
# the session that issued it.
MAILER_OTP_EXP="3600"
# Default per-address mail spacing. Do not lower it.
MAILER_MAX_FREQUENCY="1m"

# The application schema requires 8 characters. The Supabase CLI local config
# still ships 6, so set this explicitly on every self-hosted instance.
PASSWORD_MIN_LENGTH="8"

# Backstops. 20 per hour is far above real external-registration volume, sits
# under every relay's hourly throughput cap, and cannot reach 300 a day without
# deliberate abuse.
RATE_LIMIT_EMAIL_SENT="20"
RATE_LIMIT_OTP="30"

# The relay block above already carries SMTP_SENDER_NAME. Do not repeat it
# here; a duplicated key resolves by last-one-wins and hides a stale value.


# --- 4. Origins. Fill once, per target deployment -----------------------------
# The System CLOIE origin for this target. Becomes GOTRUE_SITE_URL and the
# redirect allowlist. Include the /verify-email and /reset-password origins.
SITE_URL="<<FILL: https origin of this System CLOIE deployment>>"
ADDITIONAL_REDIRECT_URLS="<<FILL: the same origin, comma-separated if more than one>>"


# --- 5. Application deployment (NOT this file, NOT the Supabase resource) ----
# Set this single value in the System CLOIE application resource so recovery
# links are deterministic behind the proxy. No other application value is
# involved in mail, and none should be added.
#   NEXT_PUBLIC_SITE_URL="<<FILL: same origin as SITE_URL above>>"


# ==============================================================================
# Leftover placeholder check. Run before restarting Auth. It inspects only
# uncommented assignments, so the comment lines above are not self-matching.
# It prints every unfilled token and exits non-zero while any remain.
# ==============================================================================
#   grep -nE '^[[:space:]]*[A-Z0-9_]+=.*<<FILL' mail.env \
#     && echo "STOP: placeholders remain" || echo "ready"
